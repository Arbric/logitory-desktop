{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logitory",
  "version": "1.0.0",
  "identifier": "io.logitory.desktop",
  "build": {
    "frontendDist": "https://logitory.io/login/",
    "devUrl": "https://logitory.io/login/"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Logitory",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Logitory LLC",
    "copyright": "© 2026 Logitory LLC. All Rights Reserved.",
    "category": "Business",
    "shortDescription": "Inventory and logistics for warehouses and service fleets",
    "longDescription": "Logitory keeps your warehouses, service vehicles and parts in one place, so you always know what stock you have, where it is, and when to reorder.",
    "homepage": "https://logitory.io",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
